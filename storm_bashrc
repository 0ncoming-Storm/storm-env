#!/bin/bash
# storm_bashrc - Your persistent interactive configuration loaded from Git

# ==============================================================================
# ENVIRONMENT & ALIASES
# ==============================================================================
export CLICOLOR=1
# NOTE: GREP_OPTIONS was removed here. grep >= 2.21 no longer honours it (GNU
# grep 3.8 silently ignores it). Use the `grep --color=auto` alias below instead.
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

alias ls='ls --color=auto'
alias la='ls -lah'
alias ll='ls -lh'
alias ..='cd ..'
alias grep='grep --color=auto'
alias c='clear'
alias n='nvim'
alias mem='free -m -t'
alias cpu='top -o %CPU'
alias usage='du -sh * | sort -h'

build() {
  if [ -z "$1" ]; then
    echo "Usage: build <filename_without_extension>"
    return 1
  fi
  g++ -Wall -Wextra "$1".cpp -o "$1" && ./"$1"
}

mkcd() {
  if [ -z "$1" ]; then
    echo "Usage: mkcd <directory_path>"
    return 1
  fi
  mkdir -p "$1" && cd "$1"
}

# History setup
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoreboth:erasedups
shopt -s histappend cdspell

# readline bindings only make sense in an interactive shell; running them
# otherwise prints "bind: warning: line editing not enabled" on every ssh cmd.
case "$-" in
  *i*)
    bind '"\e[A": history-search-backward'
    bind '"\e[B": history-search-forward'
    bind 'set completion-ignore-case on'
    ;;
esac

# ==============================================================================
# /TMP STORM ENVIRONMENT DEPLOYMENT
# ==============================================================================
# STORM_REPO is used everywhere below and by bootstrap.sh, but was never defined
# outside bootstrap.sh itself. Default it here and export it so child processes
# (including bootstrap.sh) inherit it. Override before sourcing to relocate.
: "${STORM_REPO:=$HOME/.storm-env}"
export STORM_REPO

export STORM="/var/tmp/$USER-storm"

# Prepend paths individually without duplicating
for dir in "$STORM/bin" "$STORM_REPO" "$HOME/.local/bin" "$HOME/bin"; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$dir:$PATH" ;;
  esac
done

# Persist config in HOME, but push heavy data/plugins/cache to /var/tmp
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$STORM/share"
export XDG_STATE_HOME="$STORM/state"
export XDG_CACHE_HOME="$STORM/cache"

# Only alias to tools that actually exist. If bootstrap failed, an unconditional
# `alias ls=eza` leaves you with no `ls` at all.
command -v nvim    >/dev/null 2>&1 && alias vim="nvim"
command -v eza     >/dev/null 2>&1 && alias ls="eza"
command -v lazygit >/dev/null 2>&1 && alias lg="lazygit"

storm-update() {
  echo "Updating Storm repository..."
  cd "$STORM_REPO" || return
  git pull
  bash "$STORM_REPO/bootstrap.sh"
  cd - >/dev/null || return
  source "$STORM_REPO/storm_bashrc"
}

storm-logs() {
  local log_file="$STORM/bootstrap.log"
  if [ -f "$log_file" ]; then
    cat "$log_file"
  else
    echo "No log file found at $log_file"
  fi
}

storm-clean() {
  # Remove ONLY this user's Storm paths. Never hardcode a username here, and
  # never use a relative path -- `rm -rf .storm-env` deletes whatever happens
  # to be named that in the current directory.
  local repo="${STORM_REPO:-$HOME/.storm-env}"

  echo -e "\033[1;33m[Storm] About to delete:\033[0m"
  echo "  $repo"
  echo "  $STORM"
  read -r -p "Proceed? This cannot be undone. (y/N) " -n 1 -r
  echo
  [[ $REPLY =~ ^[Yy]$ ]] || { echo "Aborted."; return 1; }

  rm -rf "$repo"
  rm -rf "$STORM"

  # The nvim symlink now points at nothing; drop it so bootstrap can relink.
  [ -L "$HOME/.config/nvim" ] && rm -f "$HOME/.config/nvim"

  echo -e "\033[1;32m[✓] Storm removed. Re-clone and run bootstrap.sh to reinstall.\033[0m"
}

storm-rebuild() {
  echo -e "\033[1;33m[Storm] Wiping /var/tmp environment...\033[0m"
  rm -rf "$STORM"

  if [ -d "$STORM_REPO" ]; then
    echo -e "\033[1;34m[Git] Pulling latest repository updates...\033[0m"
    git -C "$STORM_REPO" pull
  fi

  echo -e "\033[1;34m[Storm] Executing bootstrap installer...\033[0m"
  bash "$STORM_REPO/bootstrap.sh"

  echo -e "\033[1;32m[Storm] Reloading shell configuration...\033[0m"
  if [ -f "$STORM_REPO/storm_bashrc" ]; then
    source "$STORM_REPO/storm_bashrc"
  elif [ -f "$HOME/.bashrc" ]; then
    source "$HOME/.bashrc"
  fi
  echo -e "\033[1;32m[✓] Environment refresh complete!\033[0m"
}

# ==============================================================================
# REPORTING UTILITIES
# ==============================================================================
start-report() {
    START_REPORT_NUM=$(history 1 | awk '{print $1}')
    echo "Report tracking started at history entry #$START_REPORT_NUM"
}

stop-report() {
    if [ -z "$1" ]; then
        echo "Usage: stop-report <output_file>"
        return 1
    fi
    if [ -z "$START_REPORT_NUM" ]; then
        echo "Error: Run 'start-report' first."
        return 1
    fi

    local stop_num
    stop_num=$(history 1 | awk '{print $1}')

    # Extract history lines executed between start-report and stop-report
    history | awk -v start="$START_REPORT_NUM" -v stop="$stop_num" '$1 > start && $1 < stop' > "$1"

    echo "Saved history to $1 (entries $((START_REPORT_NUM + 1)) to $((stop_num - 1)))"
    unset START_REPORT_NUM
}

# Auto-Build /var/tmp Environment if wiped (Interactive Shells Only)
case "$-" in
  *i*)
    if [ ! -d "$STORM/bin" ]; then
      if [ -f "$STORM_REPO/bootstrap.sh" ]; then
        echo -e "\033[1;33m[Storm] Missing /var/tmp binaries. Rebuilding...\033[0m"
        mkdir -p "$STORM"
        bash "$STORM_REPO/bootstrap.sh"
      else
        echo -e "\033[1;31m[Storm] Warning: Missing bootstrap script at $STORM_REPO/bootstrap.sh\033[0m"
      fi
    fi
    ;;
esac

# Auto-start Tmux on SSH
# Guarded on interactivity: bash also sources .bashrc for `ssh host <cmd>`, and
# an unguarded `exec tmux` breaks scp, sftp, rsync and git-over-ssh.
case "$-" in
  *i*)
    if [ -n "$SSH_CONNECTION" ] && [ -z "$TMUX" ] && [ "$TERM" != "dumb" ]; then
      if command -v tmux >/dev/null 2>&1; then
        exec tmux new-session -A -s main
      fi
    fi
    ;;
esac
