#!/bin/bash
# storm-pkg - Declarative Package Manager CLI for Storm

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
MANIFEST="$REPO_DIR/packages.tsv"
BOOTSTRAP_FILE="$REPO_DIR/bootstrap.sh"

usage() {
    echo "Usage: storm-pkg <command> [args]"
    echo ""
    echo "Commands:"
    echo "  list                    List all declared packages"
    echo "  add <name> <repo> <pat> Add a new GitHub binary package"
    echo "  remove <name>           Remove a package declaration"
    echo "  sync [message]          Push local changes to GitHub"
    exit 1
}

cmd_list() {
    echo "=== Declared Packages ==="
    echo "• neovim (custom installer)"
    if [ -f "$MANIFEST" ]; then
        while IFS=$'\t' read -r name repo pattern; do
            echo "• $name ($repo)"
        done < "$MANIFEST"
    fi
}

cmd_add() {
    local name="$1"
    local repo="$2"
    local pattern="$3"

    if [ -z "$name" ] || [ -z "$repo" ] || [ -z "$pattern" ]; then
        echo "Error: Missing arguments."
        exit 1
    fi

    # Exact first-field match via awk. grep/sed with an interpolated name treat
    # it as a regex, so "c++" or "lib.foo" would match unintended rows.
    if awk -F'\t' -v n="$name" '$1 == n { f = 1 } END { exit !f }' "$MANIFEST" 2>/dev/null; then
        echo "Package '$name' is already declared."
        exit 1
    fi

    # Ensure files ends in newline, then append tab-separated values
    [ -s "$MANIFEST" ] && sed -i -e '$a\' "$MANIFEST"
    printf "%s\t%s\t%s\n" "$name" "$repo" "$pattern" >> "$MANIFEST"
    
    echo " [+] Added $name ($repo) to manifest"
    # Use an explicit `if`, not `[[ ]] && cmd`: as the last statement a failed
    # test makes the function exit 1, so `storm-pkg add x && ...` silently
    # skips everything after it when you decline the prompt.
    if [ -t 0 ]; then
        read -r -p "Commit and push to GitHub now? (y/N) " -n 1
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            cmd_sync "Add $name package"
        fi
    else
        echo " (non-interactive -- run 'storm-pkg sync' to commit and push)"
    fi
}

cmd_remove() {
    local name="$1"
    if [ -z "$name" ]; then
        echo "Error: Missing package name."
        exit 1
    fi
    if ! awk -F'\t' -v n="$name" '$1 == n { f = 1 } END { exit !f }' "$MANIFEST" 2>/dev/null; then
        echo "Package '$name' not found."
        exit 1
    fi

    # Rewrite without the matching row (exact field compare, not a regex).
    local tmp="$MANIFEST.tmp"
    awk -F'\t' -v n="$name" '$1 != n' "$MANIFEST" > "$tmp" && mv "$tmp" "$MANIFEST"
    echo " [-] Removed $name from manifest"

    if [ -t 0 ]; then
        read -r -p "Commit and push to GitHub now? (y/N) " -n 1
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            cmd_sync "Remove $name package"
        fi
    else
        echo " (non-interactive -- run 'storm-pkg sync' to commit and push)"
    fi
}

cmd_sync() {
    local msg="${1:-Sync package manifest}"
    cd "$REPO_DIR" || exit
    
    echo "=== Syncing Manifest & Scripts ==="
    git add packages.tsv bootstrap.sh init.sh storm-pkg
    git commit -m "$msg"
    git push
    
    echo " [↻] Triggering local rebuild..."
    bash "$BOOTSTRAP_FILE"
}

case "$1" in
    list) cmd_list ;;
    add) cmd_add "$2" "$3" "$4" ;;
    remove|rm) cmd_remove "$2" ;;
    sync) cmd_sync "$2" ;;
    *) usage ;;
esac
