#!/bin/bash
# storm-pkg - Declarative Package Manager CLI for Storm

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
BOOTSTRAP_FILE="$REPO_DIR/bootstrap.sh"
STORM_DIR="/tmp/$USER-storm"

if [ ! -f "$BOOTSTRAP_FILE" ]; then
    echo "Error: bootstrap.sh not found in $REPO_DIR"
    exit 1
fi

usage() {
    echo "Usage: storm-pkg <command> [args]"
    echo ""
    echo "Commands:"
    echo "  list                      List all declared packages"
    echo "  add <name> <repo> <pat>   Add a new GitHub binary package"
    echo "  remove <name>             Remove a package declaration"
    echo "  sync [commit_message]     Push local changes or pull & refresh on remote"
    exit 1
}

is_remote_env() {
    [[ "$REPO_DIR" == "$STORM_DIR/repo"* ]] || [ -d "$STORM_DIR" ]
}

cmd_list() {
    echo "=== Declared Packages in bootstrap.sh ==="
    grep -E 'install_github_bin|install_neovim' "$BOOTSTRAP_FILE" | grep -v '^\s*#' | while read -r line; do
        if echo "$line" | grep -q "install_neovim"; then
            echo "  • neovim (custom installer)"
        else
            pkg=$(echo "$line" | cut -d'"' -f2)
            repo=$(echo "$line" | cut -d'"' -f4)
            echo "  • $pkg ($repo)"
        fi
    done
}

cmd_add() {
    local name="$1"
    local repo="$2"
    local pattern="$3"

    if [ -z "$name" ] || [ -z "$repo" ] || [ -z "$pattern" ]; then
        echo "Error: Missing arguments."
        echo "Usage: storm-pkg add <bin_name> <user/repo> <file_pattern>"
        echo "Example: storm-pkg add bat sharkdp/bat x86_64-unknown-linux-musl.tar.gz"
        exit 1
    fi

    if grep -q "install_github_bin \"$name\"" "$BOOTSTRAP_FILE"; then
        echo "Package '$name' is already declared in bootstrap.sh"
        exit 1
    fi

    local line="install_github_bin \"$name\" \"$repo\" \"$pattern\""
    
    if grep -q 'echo "=== Sync Complete ==="' "$BOOTSTRAP_FILE"; then
        sed -i "/echo \"=== Sync Complete ===\"/i $line" "$BOOTSTRAP_FILE"
    else
        echo "$line" >> "$BOOTSTRAP_FILE"
    fi

    echo " [+] Added $name ($repo) to bootstrap.sh"
    
    read -p "Commit and push to GitHub now? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        cmd_sync "Add $name package"
    fi
}

cmd_remove() {
    local name="$1"

    if [ -z "$name" ]; then
        echo "Usage: storm-pkg remove <bin_name>"
        exit 1
    fi

    if ! grep -q "install_github_bin \"$name\"" "$BOOTSTRAP_FILE"; then
        echo "Package '$name' not found in bootstrap.sh"
        exit 1
    fi

    sed -i "/install_github_bin \"$name\"/d" "$BOOTSTRAP_FILE"
    echo " [-] Removed $name from bootstrap.sh"

    read -p "Commit and push to GitHub now? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        cmd_sync "Remove $name package"
    fi
}

cmd_sync() {
    local msg="${1:-Sync package manifest}"
    cd "$REPO_DIR" || exit

    if is_remote_env; then
        echo "=== Running Remote Sync & Refresh ==="
        echo " [↓] Pulling latest changes from GitHub..."
        git pull --rebase origin main || git pull origin main
        
        echo " [↻] Triggering package refresh..."
        if [ -f "$BOOTSTRAP_FILE" ]; then
            bash "$BOOTSTRAP_FILE"
        fi
        echo "=== Remote Refresh Complete ==="
    else
        echo "=== Running Local Sync (Pushing to GitHub) ==="
        git add bootstrap.sh
        git commit -m "$msg"
        git push
        echo "=== Local Sync Complete ==="
    fi
}

case "$1" in
    list)
        cmd_list
        ;;
    add)
        cmd_add "$2" "$3" "$4"
        ;;
    remove|rm)
        cmd_remove "$2"
        ;;
    sync)
        cmd_sync "$2"
        ;;
    *)
        usage
        ;;
esac
