#!/usr/bin/env bash

# ==============================================================================
# storm-pkg: Universal Binary & Archive Package Downloader / Installer
# Handles single executables, .gz, .tar.gz, .tgz, .zip, and raw binaries.
# ==============================================================================

set -euo pipefail

PREFIX="${STORM_PREFIX:-/tmp/${USER}-storm}"
BIN_DIR="${PREFIX}/bin"

mkdir -p "$BIN_DIR"

usage() {
    cat <<EOF
Usage: storm-pkg install <name> <download_url> [binary_name_inside_archive]

Examples:
  storm-pkg install tree-sitter https://github.com/tree-sitter/tree-sitter/releases/download/v0.22.6/tree-sitter-linux-x64.gz
  storm-pkg install nvim https://github.com/neovim/neovim/releases/download/v0.10.0/nvim-linux64.tar.gz nvim
EOF
    exit 1
}

decompress_and_install() {
    local name="$1"
    local url="$2"
    local bin_in_archive="${3:-$name}"
    local dest="${BIN_DIR}/${name}"
    local tmp_dir

    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT

    echo "==> Downloading ${name} from ${url}..."
    local filename
    filename="$(basename "$url")"
    local download_path="${tmp_dir}/${filename}"

    curl -sSL "$url" -o "$download_path"

    # Detect file type via file command or extension
    local file_type
    file_type="$(file -b "$download_path")"

    echo "==> Extracting and installing ${name}..."

    case "$file_type" in
        *gzip*)
            if [[ "$download_path" == *.tar.gz || "$download_path" == *.tgz ]]; then
                tar -xzf "$download_path" -C "$tmp_dir"
                find_and_install "$tmp_dir" "$bin_in_archive" "$dest"
            else
                gunzip -c "$download_path" > "$dest"
            fi
            ;;
        *Zip*)
            unzip -q "$download_path" -d "$tmp_dir"
            find_and_install "$tmp_dir" "$bin_in_archive" "$dest"
            ;;
        *POSIX\ tar*|*tar\ archive*)
            tar -xf "$download_path" -C "$tmp_dir"
            find_and_install "$tmp_dir" "$bin_in_archive" "$dest"
            ;;
        *XZ*)
            if [[ "$download_path" == *.tar.xz ]]; then
                tar -xJf "$download_path" -C "$tmp_dir"
                find_and_install "$tmp_dir" "$bin_in_archive" "$dest"
            else
                unxz -c "$download_path" > "$dest"
            fi
            ;;
        *ELF*)
            cp "$download_path" "$dest"
            ;;
        *)
            # Fallback for plain text/shell or uncompressed direct files
            cp "$download_path" "$dest"
            ;;
    esac

    chmod +x "$dest"
    echo "✔ Successfully installed ${name} to ${dest}"
}

find_and_install() {
    local search_dir="$1"
    local target_name="$2"
    local dest_path="$3"

    local match
    match="$(find "$search_dir" -type f -name "$target_name" | head -n 1)"

    if [[ -z "$match" ]]; then
        # Fallback search for any ELF executable matching target_name
        match="$(find "$search_dir" -type f -executable ! -name "*.sh" | head -n 1)"
    fi

    if [[ -n "$match" ]]; then
        cp "$match" "$dest_path"
    else
        echo "Error: Could not locate binary '${target_name}' inside extracted archive." >&2
        exit 1
    fi
}

case "${1:-}" in
    install)
        shift
        if [[ $# -lt 2 ]]; then
            usage
        fi
        decompress_and_install "$@"
        ;;
    *)
        usage
        ;;
esac
