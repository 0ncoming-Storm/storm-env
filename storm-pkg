#!/usr/bin/env bash

# ==============================================================================
# storm-pkg: Interactive & Automated Binary Package Manager
# ==============================================================================

set -euo pipefail

PREFIX="${STORM_PREFIX:-/tmp/${USER}-storm}"
BIN_DIR="${PREFIX}/bin"

mkdir -p "$BIN_DIR"

usage() {
    cat <<EOF
Storm Package Manager (storm-pkg)

Usage:
  storm-pkg                        (Interactive mode)
  storm-pkg install <name> <url> [bin_name]
  storm-pkg list
  storm-pkg remove <name>

EOF
}

decompress_and_install() {
    local name="$1"
    local url="$2"
    local bin_in_archive="${3:-$name}"
    local dest="${BIN_DIR}/${name}"
    
    local tmp_dir=""
    tmp_dir="$(mktemp -d)"
    trap 'if [[ -n "${tmp_dir:-}" && -d "${tmp_dir:-}" ]]; then rm -rf "$tmp_dir"; fi' EXIT

    echo "==> Downloading ${name} from ${url}..."
    local filename
    filename="$(basename "$url")"
    local download_path="${tmp_dir}/${filename}"

    curl -sSL "$url" -o "$download_path"

    local file_type
    file_type="$(file -b "$download_path")"

    echo "==> Extracting and installing ${name}..."

    case "$file_type" in
        *gzip*)
            if [[ "$download_path" == *.tar.gz || "$download_path" == *.tgz ]]; then
                tar -xzf "$download_path" -C "$tmp_dir"
                find_and_install "$tmp_dir" "$bin_in_archive" "$dest"
            else
                gunzip -c "$download_path" > "$dest"
            fi
            ;;
        *Zip*)
            unzip -q "$download_path" -d "$tmp_dir"
            find_and_install "$tmp_dir" "$bin_in_archive" "$dest"
            ;;
        *POSIX\ tar*|*tar\ archive*)
            tar -xf "$download_path" -C "$tmp_dir"
            find_and_install "$tmp_dir" "$bin_in_archive" "$dest"
            ;;
        *XZ*)
            if [[ "$download_path" == *.tar.xz ]]; then
                tar -xJf "$download_path" -C "$tmp_dir"
                find_and_install "$tmp_dir" "$bin_in_archive" "$dest"
            else
                unxz -c "$download_path" > "$dest"
            fi
            ;;
        *)
            cp "$download_path" "$dest"
            ;;
    esac

    chmod +x "$dest"
    echo "✔ Successfully installed ${name} to ${dest}"
}

find_and_install() {
    local search_dir="$1"
    local target_name="$2"
    local dest_path="$3"

    local match
    match="$(find "$search_dir" -type f -name "$target_name" | head -n 1)"

    if [[ -z "$match" ]]; then
        match="$(find "$search_dir" -type f -executable ! -name "*.sh" | head -n 1)"
    fi

    if [[ -n "$match" ]]; then
        cp "$match" "$dest_path"
    else
        echo "Error: Could not locate binary '${target_name}' inside extracted archive." >&2
        exit 1
    fi
}

list_packages() {
    echo "Installed binaries in ${BIN_DIR}:"
    ls -lh "${BIN_DIR}"
}

remove_package() {
    local name="$1"
    if [[ -f "${BIN_DIR}/${name}" ]]; then
        rm -f "${BIN_DIR}/${name}"
        echo "✔ Removed ${name}"
    else
        echo "Package ${name} is not installed."
    fi
}

interactive_menu() {
    echo "================================="
    echo "     storm-pkg Interactive Menu   "
    echo "================================="
    echo "1) List installed binaries"
    echo "2) Install a package from URL"
    echo "3) Remove a binary"
    echo "4) Exit"
    echo -n "Select an option [1-4]: "
    read -r choice

    case "$choice" in
        1) list_packages ;;
        2)
            echo -n "Enter package name (e.g., fzf): "
            read -r p_name
            echo -n "Enter package download URL: "
            read -r p_url
            decompress_and_install "$p_name" "$p_url"
            ;;
        3)
            echo -n "Enter binary name to remove: "
            read -r p_name
            remove_package "$p_name"
            ;;
        4) exit 0 ;;
        *) echo "Invalid option." ;;
    esac
}

# Main Command Dispatcher
case "${1:-}" in
    "")
        interactive_menu
        ;;
    install)
        shift
        if [[ $# -lt 2 ]]; then usage; fi
        decompress_and_install "$@"
        ;;
    list)
        list_packages
        ;;
    remove)
        shift
        remove_package "$1"
        ;;
    *)
        usage
        ;;
esac
